# Dependencies
node_modules

# Next.js build output
.next
# The second production build the Playwright photo suite makes, kept out of
# `.next` so it cannot be mistaken for the one `npm run test:build` measures.
# See `TIW_DIST_DIR` in next.config.ts.
.next-photos
out
next-env.d.ts

# Test artefacts
coverage
playwright-report
test-results
blob-report
.playwright

# TypeScript incremental build
*.tsbuildinfo

# Environment — never commit secrets, they are injected at runtime
.env
.env.*
!.env.example

# Tooling / platform
.vercel
.eslintcache

# Content tooling — leftover of an atomic write killed mid-rename
# (npm run geocode, npm run index-photos)
*.geocode-*.tmp
*.index-photos-*.tmp

# Agent worktrees — a sibling checkout of this very repository, hundreds of MB.
# Only `worktrees/`: whether project-level Claude settings belong in version
# control is a separate decision, and this line does not make it.
.claude/worktrees/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
