{
  "name": "travels-in-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run validate:content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:lint": "vitest run --config vitest.lint.config.ts",
    "test:e2e": "npm run test:e2e:content && playwright test",
    "test:e2e:content": "playwright test --config playwright.content.config.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run validate:content",
    "validate:content": "node --import ./scripts/runtime/register-typescript.mts scripts/validate-content.ts",
    "geocode": "node --import ./scripts/runtime/register-typescript.mts scripts/geocode.ts",
    "new-trip": "node --import ./scripts/runtime/register-typescript.mts scripts/new-trip.ts",
    "index-photos": "node scripts/not-implemented.mjs index-photos TIW-17",
    "basemap:coverage": "node --import ./scripts/runtime/register-typescript.mts scripts/generate-basemap-coverage.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
